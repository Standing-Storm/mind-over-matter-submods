[
  {
    "type": "MOD_INFO",
    "id": "mom_no_exercise_learning_powers",
    "name": "Mind Over Matter: <color_magenta>Learning Powers is NO_EXERCISE</color>",
    "authors": [ "Standing-Storm" ],
    "description": "Changes studying and learning powers to NO_EXERCISE, preventing them from using up your weariness.",
    "category": "rebalance",
    "dependencies": [ "dda", "mindovermatter" ]
  },
  {
    "id": "ACT_PSI_STUDYING_POWER_MODDED",
    "type": "activity_type",
    "activity_level": "NO_EXERCISE",
    "verb": "meditating",
    "based_on": "time",
    "rooted": true,
    "do_turn_eoc": "EOC_PSI_STUDYING_POWER"
  },
  {
    "id": "ACT_PSI_LEARNING_NEW_POWER_MODDED",
    "type": "activity_type",
    "activity_level": "NO_EXERCISE",
    "verb": "meditating",
    "rooted": true,
    "based_on": "time"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PSI_STUDYING_POWER_INITIAL_SETUP",
    "condition": { "not": { "u_has_any_effect": [ "weary_7", "weary_8" ] } },
    "effect": [
      {
        "if": { "math": [ "u_vitamin('vitamin_maintained_powers') > 0" ] },
        "then": {
          "if": { "u_query": "Would you like to end concentration on your powers before you begin to meditate?", "default": true },
          "then": { "run_eocs": "EOC_END_PSI_POWERS_MAINTAINED" }
        }
      },
      { "u_message": "You attempt to unlock new capabilities within your mind." },
      { "run_eocs": "EOC_PSI_STUDYING_DUST_CONVERSION" },
      { "u_assign_activity": "ACT_PSI_LEARNING_NEW_POWER_MODDED", "duration": "16 hours" },
      { "u_add_effect": "effect_psi_learning_new_power", "duration": "16 hours" }
    ],
    "false_effect": [ { "u_message": "You are too exhausted to contemplate anything.", "type": "bad" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PSI_CANCELLING_ACTIVITY_CANCELS_RESEARCH",
    "eoc_type": "EVENT",
    "required_event": "character_finished_activity",
    "condition": {
      "and": [
        {
          "or": [
            { "compare_string": [ "ACT_PSI_LEARNING_NEW_POWER_MODDED", { "context_val": "activity" } ] },
            { "compare_string": [ "ACT_PSI_STUDYING_POWER_MODDED", { "context_val": "activity" } ] }
          ]
        },
        {
          "or": [ { "u_has_effect": "effect_psi_learning_new_power" }, { "u_has_effect": "effect_psi_studying_power" } ]
        }
      ]
    },
    "effect": [ { "u_lose_effect": [ "effect_psi_learning_new_power", "effect_psi_studying_power" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PSI_STUDYING_POWER_BEGIN",
    "condition": { "not": { "u_has_any_effect": [ "weary_7", "weary_8" ] } },
    "effect": [
      {
        "if": { "math": [ "u_vitamin('vitamin_maintained_powers') > 0" ] },
        "then": {
          "if": { "u_query": "Would you like to end concentration on your powers before you begin to meditate?", "default": true },
          "then": { "run_eocs": "EOC_END_PSI_POWERS_MAINTAINED" }
        }
      },
      { "u_message": "You spend some time meditating and contemplating your powers.", "type": "good" },
      { "math": [ "u_psi_studying_tick_experience_counter = 0" ] },
      { "u_add_effect": "effect_psi_studying_power", "duration": "24 hours" },
      { "u_assign_activity": "ACT_PSI_STUDYING_POWER_MODDED", "duration": "24 hours" },
      { "run_eocs": "EOC_PSI_STUDYING_DUST_CONVERSION" },
      { "run_eocs": "EOC_PSI_STUDYING_POWER_METAPHYSICS_GAIN", "time_in_future": [ "30 seconds", "5 minutes" ] }
    ],
    "false_effect": [ { "u_message": "You are too exhausted to contemplate anything.", "type": "bad" } ]
  }
]
